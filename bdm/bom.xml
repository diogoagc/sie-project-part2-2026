<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<businessObjectModel xmlns="http://documentation.bonitasoft.com/bdm-xml-schema/1.0" modelVersion="1.0">
    <businessObjects>
        <businessObject qualifiedName="com.company.model.Pedido">
            <description></description>
            <fields>
                <field type="STRING" length="255" name="titulo" nullable="true" collection="false">
                    <description>Título curto do pedido (ex: "Corrigir bug no login")</description>
                </field>
                <field type="STRING" length="255" name="descricao" nullable="true" collection="false">
                    <description>Detalhe completo do pedido submetido pelo utilizador</description>
                </field>
                <field type="STRING" length="255" name="tipo" nullable="true" collection="false"/>
                <field type="INTEGER" length="255" name="estimativaDias" nullable="true" collection="false">
                    <description>Esforço estimado em dias. Usado no gateway "Ajuste com até 1 dia?"</description>
                </field>
                <field type="BOOLEAN" length="255" name="classificacaoValida" nullable="true" collection="false">
                    <description>true = gestor validou a classificação | false = gestor pediu reavaliação</description>
                </field>
                <field type="STRING" length="255" name="observacoesGestor" nullable="true" collection="false">
                    <description>Notas do gestor quando rejeita a classificação do programador</description>
                </field>
                <field type="BOOLEAN" length="255" name="finalizado" nullable="true" collection="false"/>
            </fields>
            <uniqueConstraints/>
            <queries/>
            <indexes/>
        </businessObject>
        <businessObject qualifiedName="com.company.model.RegistarHoras">
            <fields>
                <field type="INTEGER" length="255" name="horas" nullable="true" collection="false"/>
            </fields>
            <uniqueConstraints/>
            <queries/>
            <indexes/>
        </businessObject>
    </businessObjects>
</businessObjectModel>

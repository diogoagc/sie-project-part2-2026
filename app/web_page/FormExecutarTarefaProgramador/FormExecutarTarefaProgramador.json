      ],
      "exposed" : false
    },
    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.registarHoras && $data.pedido ){",
        "\treturn {",
        "\t\t//map registarHoras variable to expected task contract input",
        "\t\tregistarHorasInput: {",
        "\t\t\thoras: $data.registarHoras.horas !== undefined ? $data.registarHoras.horas : null",
        "\t\t},",
        "\t\t//map pedido variable to expected task contract input",
        "\t\tpedidoInput: {",
        "\t\t\tfinalizado: $data.pedido.finalizado !== undefined ? $data.pedido.finalizado : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
